# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing and linting caches
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/

# IDE and editors
.vscode/
.idea/
*.swp
*.swo

# Model binaries and serialized estimators (MUST NOT be committed)
*.joblib
*.pkl
artifacts/*.joblib
artifacts/*.pkl
artifacts/models/
models/*.joblib
models/*.pkl

# Raw datasets and temporary download caches (MUST NOT be redistributed)
data/raw/
data/*.zip
data/Faults.*
data/Faults27x7*
data/cache/

# Exceptions: keep config, fixtures, and verified metrics committed
!configs/
!configs/*.yaml
!tests/fixtures/*.csv
!metrics/
!metrics/*.json
!requirements.txt
